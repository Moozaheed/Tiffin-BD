# Application
NODE_ENV=development
APP_PORT=3000
APP_NAME=TiffinBD
APP_VERSION=1.0.0
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=tiffinbd_user
DB_PASSWORD=tiffinbd_password_dev
DB_DATABASE=tiffinbd_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production-very-long-random-string-here
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-very-long-random-string-here
JWT_REFRESH_EXPIRATION=604800

# Logging
LOG_FORMAT=json
LOG_OUTPUT=console
LOG_FILEPATH=/var/log/tiffinbd/

# Connector Secrets (Third-Party Integrations)
FOODPANDA_HMAC_SECRET=your-foodpanda-hmac-secret
FOODI_HMAC_SECRET=your-foodi-hmac-secret
PATHAO_HMAC_SECRET=your-pathao-hmac-secret
CHILLI_POS_API_KEY=your-chilli-pos-api-key
CHILLI_POS_API_URL=https://api.chillipos.com

# Feature Flags
ENABLE_HEALTH_CHECK=true
ENABLE_SWAGGER=true
